import torch
from transformers import AutoTokenizer, EsmForMaskedLM
import numpy as np

# Configuration
# The Wild-Type sequence of PfDHFR (from UniProt Q8I1R6)
wt_sequence = ""

# Clean up the sequence (remove spaces if any)
wt_sequence = wt_sequence.replace(" ", "")

# Mutation to test: V108N (we know from our previous analysis it's V->N in our sequence)
position = 108 # 1-based index
wt_aa = wt_sequence[position - 1]
mut_aa = "N"

print(f"Wild-Type Sequence Length: {len(wt_sequence)}")
print(f"Position {position}: Wild-Type is {wt_aa}, Mutant is {mut_aa}")

# Load ESM-2 Model
# We use a smaller version to fit on a standard computer
model_name = "facebook/esm2_t6_8M_UR50D"
print(f"\nLoading model {model_name}...")
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = EsmForMaskedLM.from_pretrained(model_name)
model.eval()

# Score the mutation
# We use the "Masked Marginal" approach:
# 1. Mask the position 108
# 2. Ask the model to predict what should be there
# 3. Compare probability of Wild-Type vs Mutant

print("Running inference...")
# Create the masked sequence
masked_sequence = wt_sequence[:position - 1] + "<mask>" + wt_sequence[position:]

# Tokenize
inputs = tokenizer(masked_sequence, return_tensors="pt")

with torch.no_grad():
    outputs = model(**inputs)

# Get logits for the masked position
# The mask token is at index 1 (after the start token)
logits = outputs.logits[0, 1, :] 

# Get the token IDs for the wild-type and mutant amino acids
wt_token_id = tokenizer.convert_tokens_to_ids(wt_aa)
mut_token_id = tokenizer.convert_tokens_to_ids(mut_aa)

# Calculate log-probabilities
log_probs = torch.log_softmax(logits, dim=-1)
wt_log_prob = log_probs[wt_token_id].item()
mut_log_prob = log_probs[mut_token_id].item()

# The LLR (Log-Likelihood Ratio) score
# Negative score means the mutation is disfavored (likely deleterious)
llr_score = mut_log_prob - wt_log_prob

print("\n--- ESM-2 Evolutionary Scoring Results ---")
print(f"Log P(Wild-Type '{wt_aa}'): {wt_log_prob:.4f}")
print(f"Log P(Mutant '{mut_aa}'): {mut_log_prob:.4f}")
print(f"Delta Log-Likelihood (LLR): {llr_score:.4f}")

if llr_score < 0:
    print("Conclusion: ESM-2 predicts this mutation is evolutionarily DISFAVORED (likely deleterious).")
else:
    print("Conclusion: ESM-2 predicts this mutation is evolutionarily TOLERATED.")

print("\nComparison with Docking:")
print(f"Docking Binding Affinity: -6.859 kcal/mol (Mutant) vs -7.018 kcal/mol (WT)")
print(f"Binding Delta: {( -6.859) - (-7.018):.3f} kcal/mol")